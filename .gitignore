# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# --- Unused audio assets (auto-generated by audio tracker) -------------------
# IMPORTANT: We ignore *.mp3 FILES (not the folder) so git still traverses
# subdirectories and the ! negation rules below actually work.
# Git rule: you cannot un-ignore a file inside an ignored *directory*.
Sound Effects/**/*.mp3
Sound Effects/*.mp3
Sound Effects/**/*.mp3.import
Sound Effects/*.mp3.import
