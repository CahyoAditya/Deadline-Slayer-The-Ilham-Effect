  <library_effects>
    <effect id="woodframe-effect">
      <profile_COMMON>
        <newparam sid="Image_003-surface">
          <surface type="2D">
            <init_from>Image_003</init_from>
          </surface>
        </newparam>
        <newparam sid="Image_003-sampler">
          <sampler2D>
            <source>Image_003-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Image_003-sampler" texcoord="Attribute"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
