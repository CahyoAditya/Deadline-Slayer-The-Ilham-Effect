[node name="BSODBody" type="Label" parent="Root/KernelPanicOverlay/BSODMargin/BSODVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "[    0.000000] Kernel panic - not syncing: Fatal exception in academic workload
[    0.000000] CPU: 0 PID: 1304 Comm: kom1304 Tainted: G        W  O  4.15.0
[    0.000000] Hardware name: Kost-Room Laptop / Student Edition
[    0.000000] Call Trace:
[    0.000000]  [<ffffffff810a3005>] panic+0xe4/0x22d
[    0.000000]  [<ffffffff8106a77e>] do_exit+0xb4e/0xc30
[    0.000000]  [<ffffffff8106a93b>] do_group_exit+0x3b/0xb0
[    0.000000]  [<ffffffff81076f74>] get_signal+0x294/0x6c0
[    0.000000]  [<ffffffff81003207>] do_signal+0x37/0x710
[    0.000000] ---[ end Kernel panic - not syncing: Fatal exception ]---

PRESS [R] REPEATEDLY TO FORCE MANUAL REBOOT (TAP RAPIDLY TO FILL THE BAR!)"
autowrap_mode = 3

